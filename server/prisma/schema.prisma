generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(STUDENT)
  branch       String?
  year         String?
  streak       Int            @default(0)
  lastActiveAt DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  quizAttempts         QuizAttempt[]
  revisions            Revision[]
  retentionPredictions RetentionPrediction[]
  studyHistories       StudyHistory[]

  @@map("users")
}

model Subject {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics Topic[]

  @@map("subjects")
}

model Topic {
  id          String     @id @default(uuid())
  subjectId   String
  name        String
  description String?
  difficulty  Difficulty @default(MEDIUM)
  summary     String?    @db.Text
  keyConcepts String?    @db.Text
  formulas    String?    @db.Text
  mistakes    String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  subject              Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  quizzes              Quiz[]
  questions            Question[]
  revisions            Revision[]
  retentionPredictions RetentionPrediction[]
  studyHistories       StudyHistory[]

  @@map("topics")
}

model Question {
  id            String     @id @default(uuid())
  topicId       String
  question      String     @db.Text
  options       String[]
  correctAnswer Int
  explanation   String?    @db.Text
  difficulty    Difficulty @default(MEDIUM)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  topic   Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@map("questions")
}

model Quiz {
  id             String   @id @default(uuid())
  topicId        String
  title          String
  totalQuestions Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topic    Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@map("quizzes")
}

model QuizAttempt {
  id            String   @id @default(uuid())
  quizId        String
  userId        String
  score         Int
  totalMarks    Int
  accuracy      Float
  confidence    Float
  confidenceGap Float
  masteryScore  Float
  timeSpentSec  Int      @default(0)
  completedAt   DateTime @default(now())

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@map("quiz_attempts")
}

model Answer {
  id             String  @id @default(uuid())
  attemptId      String
  questionId     String
  selectedAnswer Int
  isCorrect      Boolean
  timeSpent      Int     @default(0)

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model Revision {
  id               String    @id @default(uuid())
  userId           String
  topicId          String
  confidenceBefore Float?
  confidenceAfter  Float?
  scoreBefore      Float?
  scoreAfter       Float?
  retentionBefore  Float?
  retentionAfter   Float?
  revisionDate     DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("revisions")
}

model RetentionPrediction {
  id                      String    @id @default(uuid())
  userId                  String
  topicId                 String
  retentionScore          Float
  forgettingRisk          RiskLevel
  memoryStrength          Float
  recommendedRevisionDate DateTime
  calculatedAt            DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("retention_predictions")
}

model StudyHistory {
  id            String   @id @default(uuid())
  userId        String
  topicId       String
  studyDuration Int      @default(0)
  studyDate     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("study_histories")
}
